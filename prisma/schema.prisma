generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FoodCategory {
  vegetable
  fruit
  meat
  egg_milk
  staple
  seasoning
  other
}

enum StorageArea {
  fridge
  freezer
  door
  drawer
}

enum FoodStatus {
  normal
  consumed
  discarded
}

enum RecipeDifficulty {
  easy
  medium
  hard
}

enum ExpireDateSource {
  manual
  auto
}

enum VisionRecognitionStatus {
  pending
  success
  failed
}

// 食材提醒动作。ignore = 用户主动「不再提醒」；snooze = 临时「先放一放」直到 snoozedUntil。
// 不在表上设 expired/active 状态——是否生效完全由 action + snoozedUntil 即时推导，避免后台定时任务清理。
enum FoodReminderAction {
  ignore
  snooze
}

enum NotificationType {
  food_expiring
  system
}

enum NotificationStatus {
  unread
  read
}

enum NotificationTargetType {
  food
  recipe
  none
}

enum NotificationPublicationStatus {
  pending
  publishing
  completed
  partial_failed
  failed
}

// 用户角色。普通用户默认 user；运营后台访问需要 admin 或 super_admin。
// super_admin 是「兜底位」——只能由 super_admin 操作，避免互相误降权造成无人可恢复的状态。
enum UserRole {
  user
  admin
  super_admin
}

// 用户启用状态。banned 用户登录会被拒，运营可以反向 unban 恢复。
// 不在 User 上做软删——保留 cascade 删除路径让数据迁移更干净。
enum UserStatus {
  active
  banned
}

model User {
  id                    String                 @id @default(cuid())
  // 登录账号：3-32 位字母/数字/下划线，全库唯一。
  // 强校验放在 DTO 层（class-validator），DB 仅靠 @unique 兜住竞态/绕过 API 的写入。
  username              String                 @unique
  // bcryptjs 哈希值（含 cost 头），不存原密码。比对走 bcrypt.compare，rounds 由配置控制。
  passwordHash          String
  // 展示用昵称，注册时可选；为空时前端用 username 兜底渲染。
  nickname              String?
  // 头像 URL（占位，未来接 R2 上传）。MVP 阶段允许为空。
  avatar                String?
  // 运营后台权限位。注册默认 user，提权走 prisma/scripts/promote-admin.ts 或后台界面。
  role                  UserRole               @default(user)
  // 启用状态。banned 时登录直接被 AuthService 拒绝；AdminGuard 每次请求都会重新查这两个字段。
  status                UserStatus             @default(active)
  // 封禁时间戳与原因，仅供运营查询和审计。unban 时只把 status 改回 active，不清空这两个字段。
  bannedAt              DateTime?
  banReason             String?
  // 每日拍照识别额度。super_admin 不受此字段限制；0 表示该用户当天不可发起识别。
  visionDailyLimit      Int                    @default(5)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  fridges               Fridge[]
  visionRecognitionJobs VisionRecognitionJob[]
  foodReminders         FoodReminder[]
  notifications         Notification[]

  @@index([role])
  @@index([status])
}

model Fridge {
  id                    String                 @id @default(cuid())
  name                  String
  userId                String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelves               StorageShelf[]
  foods                 FoodItem[]
  visionRecognitionJobs VisionRecognitionJob[]

  @@index([userId])
}

model StorageShelf {
  id        String      @id @default(cuid())
  fridgeId  String
  area      StorageArea
  name      String
  sort      Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  fridge    Fridge      @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  foods     FoodItem[]

  @@unique([fridgeId, area, name])
  @@index([fridgeId])
}

model FoodItem {
  id               String           @id @default(cuid())
  fridgeId         String
  shelfId          String
  name             String
  category         FoodCategory
  quantity         Decimal?         @db.Decimal(10, 2)
  unit             String?
  purchaseDate     DateTime?
  expireDate       DateTime
  expireDateSource ExpireDateSource @default(manual)
  status           FoodStatus       @default(normal)
  note             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  fridge           Fridge           @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  // 层位删除策略：业务层在 FridgeService.removeShelf 中已拒绝"带食材删层位"，
  // DB 层显式 Restrict 是兜底，防止任何代码绕过业务校验时静默删除食材。
  shelf            StorageShelf     @relation(fields: [shelfId], references: [id], onDelete: Restrict)
  reminders        FoodReminder[]

  @@index([fridgeId, expireDate])
  @@index([shelfId])
  @@index([status])
}

// 单个用户对单件食材的提醒偏好。一条记录可能是「永久忽略」或「暂时延后」。
// 与 FoodItem 一比一对应（@@unique([userId, foodId])），重复调 ignore/snooze 走 upsert。
// 删除 food/user 时级联清理，不会留孤儿记录。
model FoodReminder {
  id           String             @id @default(cuid())
  userId       String
  foodId       String
  action       FoodReminderAction
  // snooze 时记录到期时间；ignore 永久生效，snoozedUntil 留 null。
  // 是否「生效」由查询端实时判断：action=ignore 或 (action=snooze AND snoozedUntil > now)。
  snoozedUntil DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  food         FoodItem           @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([userId, foodId])
  @@index([userId])
  @@index([foodId])
}

model Notification {
  id            String                 @id @default(cuid())
  userId        String
  type          NotificationType
  title         String
  content       String
  status        NotificationStatus     @default(unread)
  targetType    NotificationTargetType @default(none)
  targetId      String?
  publicationId String?
  metadata      Json?
  dedupeKey     String?
  readAt        DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, status, createdAt])
  @@index([userId, type, createdAt])
  @@index([targetType, targetId])
  @@index([publicationId, status])
}

model NotificationPublication {
  id           String                        @id @default(cuid())
  title        String
  content      String
  status       NotificationPublicationStatus @default(pending)
  targetCount  Int                           @default(0)
  successCount Int                           @default(0)
  failedCount  Int                           @default(0)
  dedupeKey    String                        @unique
  operatorId   String
  operatorName String?
  errorMessage String?
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt

  @@index([status, createdAt])
  @@index([operatorId, createdAt])
}

model VisionRecognitionJob {
  id                  String                  @id @default(cuid())
  userId              String
  fridgeId            String?
  shelfId             String?
  status              VisionRecognitionStatus @default(pending)
  requestedSourceType String                  @default("auto")
  detectedSourceType  String?
  provider            String?
  model               String?
  items               Json?
  ignored             Json?
  warnings            String[]                @default([])
  itemCount           Int                     @default(0)
  imageUrl            String?
  imageExpiresAt      DateTime?
  errorMessage        String?
  confirmedAt         DateTime?
  // Provider 用量与成本追踪。Qwen DashScope 兼容协议会返回 usage.{prompt,completion,total}_tokens；
  // 解析失败或未配置费率时全部留 null，前端用 "-" 兜底。
  // 注意：costUSD 用 Decimal(10,6) 是因为单次识别成本可能只有 $0.0001 级别，需要 6 位小数精度。
  inputTokens         Int?
  outputTokens        Int?
  totalTokens         Int?
  costUSD             Decimal?                @db.Decimal(10, 6)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fridge              Fridge?                 @relation(fields: [fridgeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([fridgeId])
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecipeSuggestionRule {
  id                  String           @id @default(cuid())
  name                String           @unique
  requiredIngredients String[]
  optionalIngredients String[]
  missingIngredients  String[]
  difficulty          RecipeDifficulty
  estimatedMinutes    Int
  reasonTemplate      String
  popularityScore     Int              @default(0)
  // 数据来源标识：'seed' = 手工种子，'howtocook' = HowToCook 仓库批量导入。
  // 用于按来源批量删除/重新导入，是接入新菜谱源（小红书/下厨房等）的基础识别字段。
  source              String?
  // 菜系/分类：HowToCook 来源对应仓库目录（meat_dish/vegetable_dish/staple/...），
  // 种子数据可填 'seed' 或具体类别。前端列表页按这个做 chip 筛选。
  category            String?
  // 操作步骤数组。HowToCook 的 ## 操作 章节按 1./2./3. 顺序拆分；空数组表示原文无步骤。
  instructions        String[]         @default([])
  // 步骤过程图。key 是 stepIndex（字符串化），value 是该步骤对应的 R2 图 URL 数组。
  // 形如 { "3": ["https://pub-xxx.r2.dev/recipes/.../焯水.jpg"], "9": [...] }。
  // 仅存有图的步骤，省存储；缺失的步骤前端按"无图"渲染。
  stepImages          Json?
  // 用料计算表。从原文 ## 计算 章节解析得来，提供定量配比（如「白糖 10 克」「可乐 500ml」）。
  // 结构：{ description: string, items: [{ name: string, amount: string }] }。
  // null 表示原文没有计算章节，前端隐藏该卡片。
  portions            Json?
  // 附加内容 / 小贴士：原文 ## 附加内容 章节中可读性较好的提示文本，过长时会被截断。
  tips                String?
  // 菜谱配图 URL。导入时下载原图上传到自有对象存储（R2），数据库存的是 R2 公开 URL。
  // 失败的菜谱此字段为 null，前端走 placeholder fallback。
  imageUrl            String?
  // 图片源头 URL。HowToCook 来源是 raw.githubusercontent.com 直链；保留它做两件事：
  //   1. 溯源/审计（管理后台能查图片原始出处）
  //   2. fallback——当 R2 不可用或 imageUrl 被误删时还能从源头补救
  imageSourceUrl      String?
  // 原文链接，方便用户查看完整教程或排查脏数据。HowToCook 用 GitHub blob URL。
  sourceRefUrl        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([source])
  @@index([category])
}
