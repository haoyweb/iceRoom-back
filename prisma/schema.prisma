generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FoodCategory {
  vegetable
  fruit
  meat
  egg_milk
  staple
  seasoning
  other
}

enum StorageArea {
  fridge
  freezer
  door
  drawer
}

enum FoodStatus {
  normal
  consumed
  discarded
}

enum RecipeDifficulty {
  easy
  medium
  hard
}

enum ExpireDateSource {
  manual
  auto
}

model User {
  id        String   @id @default(cuid())
  nickname  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fridges   Fridge[]
}

model Fridge {
  id        String         @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shelves   StorageShelf[]
  foods     FoodItem[]

  @@index([userId])
}

model StorageShelf {
  id        String      @id @default(cuid())
  fridgeId  String
  area      StorageArea
  name      String
  sort      Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  fridge    Fridge      @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  foods     FoodItem[]

  @@index([fridgeId])
  @@unique([fridgeId, area, name])
}

model FoodItem {
  id           String       @id @default(cuid())
  fridgeId     String
  shelfId      String
  name         String
  category     FoodCategory
  quantity     Decimal?     @db.Decimal(10, 2)
  unit         String?
  purchaseDate     DateTime?
  expireDate       DateTime
  expireDateSource ExpireDateSource @default(manual)
  status           FoodStatus       @default(normal)
  note         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  fridge       Fridge       @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  // 层位删除策略：业务层在 FridgeService.removeShelf 中已拒绝"带食材删层位"，
  // DB 层显式 Restrict 是兜底，防止任何代码绕过业务校验时静默删除食材。
  shelf        StorageShelf @relation(fields: [shelfId], references: [id], onDelete: Restrict)

  @@index([fridgeId, expireDate])
  @@index([shelfId])
  @@index([status])
}

model RecipeSuggestionRule {
  id                  String           @id @default(cuid())
  name                String           @unique
  requiredIngredients String[]
  optionalIngredients String[]
  missingIngredients  String[]
  difficulty          RecipeDifficulty
  estimatedMinutes    Int
  reasonTemplate      String
  popularityScore     Int              @default(0)
  // 数据来源标识：'seed' = 手工种子，'howtocook' = HowToCook 仓库批量导入。
  // 用于按来源批量删除/重新导入，是接入新菜谱源（小红书/下厨房等）的基础识别字段。
  source              String?
  // 菜系/分类：HowToCook 来源对应仓库目录（meat_dish/vegetable_dish/staple/...），
  // 种子数据可填 'seed' 或具体类别。前端列表页按这个做 chip 筛选。
  category            String?
  // 操作步骤数组。HowToCook 的 ## 操作 章节按 1./2./3. 顺序拆分；空数组表示原文无步骤。
  instructions        String[]         @default([])
  // 附加内容 / 小贴士：原文 ## 附加内容 章节中可读性较好的提示文本，过长时会被截断。
  tips                String?
  // 菜谱配图 URL。HowToCook 仓库内是 ./xxx.jpg 相对路径，入库时转成 GitHub raw 直链。
  imageUrl            String?
  // 原文链接，方便用户查看完整教程或排查脏数据。HowToCook 用 GitHub blob URL。
  sourceRefUrl        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([source])
  @@index([category])
}
