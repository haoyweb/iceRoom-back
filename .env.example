NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hy_ice_room?schema=public

# ─── JWT 鉴权 ────────────────────────────────────────────────────────
# access/refresh 用两套独立 secret——单边泄漏不会导致全军覆没。
# 生成方式（示例）：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 长度强校验 ≥32（Joi）。开发环境填随机字符串即可，生产 secret 必须走环境变量注入、严禁入仓。
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# TTL 用 zeit/ms 字符串（jsonwebtoken 原生支持）：'15m'、'7d'、'30s' 等。
# 默认 access 15 分钟、refresh 7 天；access 短是为了让 refresh 流水化生效，refresh 长是平衡用户每周需登录一次。
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# bcrypt 计算成本。10 = 约 100ms/次（开发/MVP）；上线建议 12+（约 300ms）。
BCRYPT_ROUNDS=10

# ─── Cloudflare R2 对象存储 ──────────────────────────────────────────
# 用于菜谱图片托管，避免依赖 GitHub raw。
# 开发环境可以全留空（StorageService 会降级，业务接口不受影响）。
# 生产环境/导入脚本必须配齐 5 个字段。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hy-iceroom-recipes
# 公开访问 URL：开发用 https://pub-xxx.r2.dev，生产建议绑自定义域名 https://cdn.xxx.com
R2_PUBLIC_URL=

# ─── 视觉识别 / 拍照入库 ────────────────────────────────────────────────
# API Key 只配置在后端，前端只调用本服务的上传接口。
VISION_INGREDIENT_PROVIDER=qwen
VISION_INGREDIENT_TIMEOUT_MS=20000
VISION_INGREDIENT_MAX_IMAGE_BYTES=5242880
QWEN_VISION_API_KEY=
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3-vl-flash

